rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Validação estrita de tipo e limites de dados (Anti-DoS)
    function isValidCustomerData(data) {
      return data.keys().hasAll(['name', 'dealValue', 'stage']) &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 300 &&
             data.dealValue is number &&
             data.dealValue >= 0 &&
             data.dealValue <= 1000000000 &&
             data.stage is string &&
             data.stage in ['lead', 'contacted', 'proposal', 'negotiation', 'won', 'lost'];
    }

    // 1. Coleção de Clientes e Oportunidades (Customers)
    // Sincronização multi-cliente em tempo real via onSnapshot
    match /customers/{customerId} {
      allow read: if true;
      allow create, update: if isValidCustomerData(request.resource.data);
      allow delete: if true;
    }

    // 2. Trilha de Auditoria Imutável (Audit Trail)
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['action', 'timestamp']);
      allow update, delete: if false; // Estritamente imutável
    }

    // 3. Coleção de Configurações
    match /system_config/{configId} {
      allow read, write: if true;
    }
  }
}
